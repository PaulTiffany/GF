{
  "schema": 1,
  "id": "lyric-cloud",
  "overlay_system": "manim",
  "manifest_example": "../examples/lyric-overlay.json",
  "idea": "Render selected words or short phrases as a transparent Manim overlay above an already compiled scene, using a small behavior vocabulary instead of bespoke animation code.",
  "scene_agnostic": true,
  "inputs": {
    "required": [
      "lyric_overlay_manifest"
    ],
    "optional": [
      "motif_anchor",
      "mask",
      "compiled_scene"
    ]
  },
  "behaviors": [
    "fade_hold",
    "drift_up",
    "pulse",
    "orbit",
    "rain",
    "scatter"
  ],
  "variation_knobs": [
    "anchor",
    "behavior",
    "font_scale",
    "rotation",
    "event_timing",
    "token_density"
  ],
  "good_for": [
    "bridge",
    "hook",
    "instrumental transition",
    "lyric-first passage"
  ],
  "avoid": [
    "full-song karaoke treatment by default",
    "large lyric blocks",
    "baking lyrics into source art"
  ]
}
