{
  "schema": 1,
  "id": "window-rain",
  "idea": "Apply moving rain, condensation, reflections and passing light as independent overlays to an already compiled character scene; do not bake rain into actor or set assets.",
  "scene_agnostic": true,
  "inputs": {
    "required": [
      "compiled_scene"
    ],
    "optional": [
      "rain_layer",
      "glass_reflection",
      "light_sweeps",
      "background_bokeh",
      "manim_overlay"
    ]
  },
  "variation_knobs": [
    "rain_speed",
    "reflection_opacity",
    "focus_plane",
    "camera_push",
    "light_color",
    "text_density"
  ],
  "good_for": [
    "verse",
    "pre-chorus",
    "introspection",
    "diner",
    "bedside",
    "car"
  ],
  "avoid": [
    "placing every effect at the same depth or speed",
    "baking weather into actor sheets"
  ]
}
